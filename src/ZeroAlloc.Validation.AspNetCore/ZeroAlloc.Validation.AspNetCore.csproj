<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <PackageId>ZeroAlloc.Validation.AspNetCore</PackageId>
    <Description>ASP.NET Core integration for ZeroAlloc.Validation. Source-generated action filter validates request models at compile time with zero runtime overhead.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZeroAlloc.Validation\ZeroAlloc.Validation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZeroAlloc.Validation.AspNetCore.Generator\ZeroAlloc.Validation.AspNetCore.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!--
    Bundle the generator into this package under analyzers/dotnet/cs so Roslyn registers
    it, the layout ZeroAlloc.Validation.Options uses since #183. The reference above
    applies only inside this repository, and AspNetCore.Generator is not published on its
    own, so without this the package ships no generator and neither
    AddZeroAllocAspNetCoreValidation() nor the action filter is emitted, issue #188.
    AspNetCore.Generator has no assembly dependencies to bundle alongside it: it compiles
    in the one helper it shares with the Inject generator.

    The path comes from GetTargetPath on the analyzer reference rather than being
    spelled out, so it follows Configuration and a custom artifacts path.
  -->
  <Target Name="IncludeBundledGeneratorsInPackage" BeforeTargets="_GetPackageFiles">
    <MSBuild Projects="@(ProjectReference)"
             Condition="'%(ProjectReference.OutputItemType)' == 'Analyzer'"
             Targets="GetTargetPath"
             RemoveProperties="TargetFramework">
      <Output TaskParameter="TargetOutputs" ItemName="_BundledGeneratorAssembly" />
    </MSBuild>
    <ItemGroup>
      <None Include="@(_BundledGeneratorAssembly)"
            Pack="true"
            PackagePath="analyzers/dotnet/cs"
            Visible="false" />
      <None Include="@(_BundledGeneratorAssembly->'%(RootDir)%(Directory)%(Filename).pdb')"
            Condition="Exists('%(RootDir)%(Directory)%(Filename).pdb')"
            Pack="true"
            PackagePath="analyzers/dotnet/cs"
            Visible="false" />
    </ItemGroup>
  </Target>

</Project>
