<Project>
  <!--
    Makes ZeroAllocGeneratedAccessibility CompilerVisible for a project that references this
    package directly. buildTransitive/ZeroAlloc.Validation.AspNetCore.props does the same for a
    project that only gets it transitively, through a project reference to another project that
    references this package — this package is referenced normally, not with PrivateAssets, so
    the bundled ZeroAlloc.Validation.AspNetCore.Generator analyzer runs for those consumers too.
    See #193.
  -->
  <ItemGroup>
    <CompilerVisibleProperty Include="ZeroAllocGeneratedAccessibility" />
  </ItemGroup>
</Project>
