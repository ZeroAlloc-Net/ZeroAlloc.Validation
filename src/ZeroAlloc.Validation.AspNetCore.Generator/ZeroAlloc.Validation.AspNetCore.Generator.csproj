<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" PrivateAssets="all" />
  </ItemGroup>

  <!--
    ValidatorRegistrationEmitter is compiled in from source rather than referenced from
    the Inject assembly. This generator ships bundled inside the ZeroAlloc.Validation.AspNetCore
    package, and a reference would mean bundling ZeroAlloc.Validation.Inject.dll next to it.
    Roslyn would then also run InjectGenerator from that copy, and a consumer referencing
    both AspNetCore and Inject would get AddZeroAllocValidators emitted twice and fail
    with CS0101. Options.Generator does the same, issue #183.
  -->
  <ItemGroup>
    <Compile Include="..\ZeroAlloc.Validation.Inject\ValidatorRegistrationEmitter.cs"
             Link="Shared\ValidatorRegistrationEmitter.cs" />
    <Compile Include="..\ZeroAlloc.Validation.Inject\GeneratedValidatorNames.cs"
             Link="Shared\GeneratedValidatorNames.cs" />
    <!-- GeneratedValidatorReach decides which [Validate] models get a validator, issue #216. -->
    <Compile Include="..\ZeroAlloc.Validation.Inject\GeneratedValidatorReach.cs"
             Link="Shared\GeneratedValidatorReach.cs" />
    <!-- GeneratedAccessibilityOption reads the org-wide ZeroAllocGeneratedAccessibility MSBuild
         property (issue #193). Shared the same way as ValidatorRegistrationEmitter above. -->
    <Compile Include="..\ZeroAlloc.Validation.Inject\GeneratedAccessibilityOption.cs"
             Link="Shared\GeneratedAccessibilityOption.cs" />
    <!-- ValidatorDependencies lists the validators a generated validator's constructor takes, so
         ValidatorRegistrationEmitter can register them too, issue #246. -->
    <Compile Include="..\ZeroAlloc.Validation.Inject\ValidatorDependencies.cs"
             Link="Shared\ValidatorDependencies.cs" />
    <!-- ObsoleteErrors finds [Obsolete(error: true)] properties, which ValidatorDependencies
         leaves out of the constructor, issue #267. -->
    <Compile Include="..\ZeroAlloc.Validation.Inject\ObsoleteErrors.cs"
             Link="Shared\ObsoleteErrors.cs" />
    <!-- MemberWalker decides which properties a generated validator walks, so the dependencies
         listed are exactly the ones its constructor takes, issue #246. -->
    <Compile Include="..\ZeroAlloc.Validation.Inject\MemberWalker.cs"
             Link="Shared\MemberWalker.cs" />
    <Compile Include="..\ZeroAlloc.Validation.Inject\UnreadableReason.cs"
             Link="Shared\UnreadableReason.cs" />
    <!-- The equatable models the transform extracts, so the output step stays cached, issue #209. -->
    <Compile Include="..\ZeroAlloc.Validation.Inject\ValidatedModelInfo.cs"
             Link="Shared\ValidatedModelInfo.cs" />
    <Compile Include="..\ZeroAlloc.Validation.Inject\RegistrationNode.cs"
             Link="Shared\RegistrationNode.cs" />
    <Compile Include="..\ZeroAlloc.Validation.Inject\RegistrationDependency.cs"
             Link="Shared\RegistrationDependency.cs" />
    <Compile Include="..\ZeroAlloc.Validation.Inject\EquatableArray.cs"
             Link="Shared\EquatableArray.cs" />
  </ItemGroup>

</Project>
