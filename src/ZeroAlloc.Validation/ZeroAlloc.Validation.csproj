<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <PackageId>ZeroAlloc.Validation</PackageId>
    <Description>A zero-allocation validation library for .NET. Roslyn source generator wires all rule evaluation at compile time — no reflection, no boxing, no runtime overhead.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ZeroAlloc.Pipeline" Version="1.3.0" GeneratePathProperty="true" />
    <PackageReference Include="ZeroAlloc.Pipeline.Generators" Version="1.3.0" GeneratePathProperty="true" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" PrivateAssets="all">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <!-- Run the source generator against THIS project's local build (so e.g. tests pick it up),
       and bundle it into this package below so consumers get it by referencing only
       ZeroAlloc.Validation, mirroring how ZeroAlloc.Resilience and ZeroAlloc.Rest bundle
       their own generators (issue #194). The standalone ZeroAlloc.Validation.Generator
       package is still published for backwards compatibility, but new consumers should
       reference the main package only. -->
  <ItemGroup>
    <ProjectReference Include="..\ZeroAlloc.Validation.Generator\ZeroAlloc.Validation.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <!-- Expose generator dependency DLLs as Analyzer items so Roslyn's loader finds them
       during *this* project's build. -->
  <ItemGroup>
    <Analyzer Include="$(PkgZeroAlloc_Pipeline_Generators)\lib\netstandard2.0\ZeroAlloc.Pipeline.Generators.dll" />
    <Analyzer Include="$(PkgZeroAlloc_Pipeline)\lib\netstandard2.0\ZeroAlloc.Pipeline.dll" />
  </ItemGroup>

  <!--
    Bundle the generator (and the helper DLLs it needs at generator-load time, since Roslyn
    does not resolve a generator's own PackageReference dependencies) into this package under
    analyzers/dotnet/cs, the same layout ZeroAlloc.Resilience and ZeroAlloc.Rest use to bundle
    their generators into their main package.

    The generator DLL is the one the build actually produced. Asking the generator project for
    its target path, instead of hardcoding bin\$(Configuration)\netstandard2.0, follows any
    output redirection such as artifacts-path. The hardcoded path silently bundled whatever
    stale DLL sat in the repository's bin folder, at whatever version that DLL had been built
    with. The helper DLLs are taken from the same directory, where the generator's
    CopyGeneratorHelperDlls target copies them. See ZeroAlloc-Net/.github#43.
  -->
  <Target Name="IncludeGeneratorInPackage" BeforeTargets="_GetPackageFiles">
    <MSBuild Projects="..\ZeroAlloc.Validation.Generator\ZeroAlloc.Validation.Generator.csproj"
             Targets="GetTargetPath"
             RemoveProperties="TargetFramework;RuntimeIdentifier;SelfContained">
      <Output TaskParameter="TargetOutputs" ItemName="_ZeroAllocValidationGeneratorAssembly" />
    </MSBuild>
    <ItemGroup>
      <None Include="@(_ZeroAllocValidationGeneratorAssembly)"
            Pack="true"
            PackagePath="analyzers/dotnet/cs"
            Visible="false" />
      <None Include="@(_ZeroAllocValidationGeneratorAssembly->'%(RootDir)%(Directory)ZeroAlloc.Pipeline.Generators.dll')"
            Pack="true"
            PackagePath="analyzers/dotnet/cs"
            Visible="false" />
      <None Include="@(_ZeroAllocValidationGeneratorAssembly->'%(RootDir)%(Directory)ZeroAlloc.Pipeline.dll')"
            Pack="true"
            PackagePath="analyzers/dotnet/cs"
            Visible="false" />
    </ItemGroup>
  </Target>

  <!--
    build/ZeroAlloc.Validation.targets is auto-imported by NuGet into any project that
    references this package. It fails the build with ZV9001 if the consumer also references
    ZeroAlloc.Validation.Generator directly, since this package now bundles it and a dual
    reference loads the generator twice, producing duplicate {Model}Validator types.

    build/ZeroAlloc.Validation.props makes ZeroAllocGeneratedAccessibility CompilerVisible for a
    project that references this package directly. buildTransitive/ZeroAlloc.Validation.props
    does the same for a project that only gets it transitively, through a project reference to
    another project that references this package — this package is referenced normally, not
    with PrivateAssets, so the bundled generator's analyzer, packed above, runs for those
    consumers too. See #193.
  -->
  <ItemGroup>
    <None Include="build/ZeroAlloc.Validation.targets"
          Pack="true"
          PackagePath="build/"
          Visible="false" />
    <None Include="build/ZeroAlloc.Validation.props"
          Pack="true"
          PackagePath="build/ZeroAlloc.Validation.props"
          Visible="false" />
    <None Include="buildTransitive/ZeroAlloc.Validation.props"
          Pack="true"
          PackagePath="buildTransitive/ZeroAlloc.Validation.props"
          Visible="false" />
  </ItemGroup>

</Project>
