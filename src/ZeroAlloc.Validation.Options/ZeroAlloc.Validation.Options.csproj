<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <PackageId>ZeroAlloc.Validation.Options</PackageId>
    <Description>Source-generated options validation for ZeroAlloc.Validation. Plugs compile-time validators into Microsoft.Extensions.Options with zero reflection.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZeroAlloc.Validation\ZeroAlloc.Validation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZeroAlloc.Validation.Options.Generator\ZeroAlloc.Validation.Options.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!--
    Bundle the generator into this package under analyzers/dotnet/cs so Roslyn registers
    it, the same layout ZeroAlloc.Validation.Inject uses for its own generator. The
    reference above applies only inside this repository, and Options.Generator is not
    published on its own, so without this the package ships no generator and
    ValidateWithZeroAlloc() is never emitted, issue #183. Options.Generator has no
    assembly dependencies to bundle alongside it: it compiles in the one helper it
    shares with the Inject generator.

    The path comes from GetTargetPath on the analyzer reference rather than being
    spelled out, so it follows Configuration and a custom artifacts path.
  -->
  <Target Name="IncludeBundledGeneratorsInPackage" BeforeTargets="_GetPackageFiles">
    <MSBuild Projects="@(ProjectReference)"
             Condition="'%(ProjectReference.OutputItemType)' == 'Analyzer'"
             Targets="GetTargetPath"
             RemoveProperties="TargetFramework">
      <Output TaskParameter="TargetOutputs" ItemName="_BundledGeneratorAssembly" />
    </MSBuild>
    <ItemGroup>
      <None Include="@(_BundledGeneratorAssembly)"
            Pack="true"
            PackagePath="analyzers/dotnet/cs"
            Visible="false" />
      <None Include="@(_BundledGeneratorAssembly->'%(RootDir)%(Directory)%(Filename).pdb')"
            Condition="Exists('%(RootDir)%(Directory)%(Filename).pdb')"
            Pack="true"
            PackagePath="analyzers/dotnet/cs"
            Visible="false" />
    </ItemGroup>
  </Target>

  <!--
    build/ makes ZeroAllocGeneratedAccessibility CompilerVisible for a project that references
    this package directly. buildTransitive/ does the same for a project that only gets it
    transitively, through a project reference to another project that references this package —
    this package is referenced normally, not with PrivateAssets, so the bundled generator's
    analyzer, packed above, runs for those consumers too. See #193.
  -->
  <ItemGroup>
    <None Include="build/ZeroAlloc.Validation.Options.props"
          Pack="true"
          PackagePath="build/ZeroAlloc.Validation.Options.props"
          Visible="false" />
    <None Include="buildTransitive/ZeroAlloc.Validation.Options.props"
          Pack="true"
          PackagePath="buildTransitive/ZeroAlloc.Validation.Options.props"
          Visible="false" />
  </ItemGroup>

</Project>
